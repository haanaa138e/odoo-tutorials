<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_clicker.ClickerSystray" >
        <div class="o_systray_item" >

	        Clicks:
	        <t t-esc="this.clicker.state.clicker"/>
            <button class="btn btn-secondary " t-on-click="() => this.clicker.increment(9)">
                <i class="fa fa-lg fa-plus"></i>
            </button>
	        <button t-on-click="openClicker" class="btn btn-secondary ms-2">
		        Open
	        </button>

        </div>
    </t>
</templates>


